<% content_for :title, "Entrar" %>

<%= render layout: "layouts/auth_card" do %>
  <h1 class="text-2xl font-medium">Entrar</h1>
  <p class="mb-6 mt-1 text-sm text-gray-400">Bem-vindo de volta.</p>

  <%# form_with sem "model:" => os campos saem como "email" e "password" soltos,
      exatamente o que UserSessionsController#create lê em params[:email]/params[:password]. %>
  <%= form_with url: user_session_path, class: "space-y-4" do |form| %>
    <%= form.email_field :email, placeholder: "E-mail", required: true, autofocus: true,
          class: "w-full rounded-md border border-white/20 bg-white/5 px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:outline-none" %>

    <%= form.password_field :password, placeholder: "Senha", required: true,
          class: "w-full rounded-md border border-white/20 bg-white/5 px-4 py-3 text-white placeholder-gray-500 focus:border-brand focus:outline-none" %>

    <%= form.submit "Entrar",
          class: "w-full rounded-md bg-brand px-4 py-3 font-semibold text-white cursor-pointer transition hover:bg-brand-dark" %>
  <% end %>

  <p class="mt-6 text-sm text-gray-400">
    Não tem conta? <%= link_to "Cadastre-se", new_registration_path, class: "text-white hover:underline" %>
  </p>
<% end %>
