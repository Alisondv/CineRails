<% content_for :title, "Busca" %>

<div class="px-4 sm:px-12 pt-28">
  <% if @query.blank? %>
    <h1 class="text-2xl font-bold">Digite algo na busca acima.</h1>
  <% else %>
    <h1 class="text-2xl font-bold">Resultados para "<%= @query %>"</h1>

    <% if @movies.any? %>
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-4">
        <% @movies.each do |movie| %>
          <%= render "movies/movie_card", tmdb_id: movie["id"], title: movie["title"], poster_path: movie["poster_path"] %>
        <% end %>
      </div>
    <% else %>
      <p class="mt-6 text-gray-400">Nenhum filme encontrado.</p>
    <% end %>
  <% end %>
</div>
