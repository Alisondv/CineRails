<!DOCTYPE html>
<html lang="pt-BR" class="bg-ink">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · CineRails" : "CineRails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CineRails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-ink text-white antialiased flex flex-col">
    <%# A navbar só aparece depois que um perfil foi escolhido. %>
    <%= render "layouts/navbar" if current_profile %>

    <%= render "layouts/flash" %>

    <%# yield = aqui entra o template da ação (ex.: home/index.html.erb). %>
    <main class="flex-1">
      <%= yield %>
    </main>

    <footer class="mt-16 border-t border-white/10 px-4 sm:px-12 py-8 text-sm text-gray-400">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <%= link_to "TMDB", "https://www.themoviedb.org", target: "_blank", rel: "noopener",
              class: "font-bold tracking-wide text-sky-400 hover:text-sky-300" %>
        <p>This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
      </div>
      <p class="mt-2">CineRails · projeto didático feito com Ruby on Rails <%= Rails.version %>.</p>
    </footer>
  </body>
</html>
