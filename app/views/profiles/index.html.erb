<% content_for :title, "Quem está assistindo?" %>

<div class="flex min-h-[80vh] flex-col items-center justify-center px-4">
  <%= render "shared/logo" %>
  <h1 class="text-3xl sm:text-5xl font-medium">Quem está assistindo?</h1>

  <div class="mt-10 flex flex-wrap justify-center gap-6 sm:gap-10">
    <% @profiles.each do |profile| %>
      <%# Cada avatar é um botão que faz POST /session com o profile_id. %>
      <%= button_to session_path, params: { profile_id: profile.id },
            class: "group flex flex-col items-center gap-3 cursor-pointer" do %>
        <%= profile_avatar(profile, size: "w-24 h-24 sm:w-36 sm:h-36 text-5xl sm:text-6xl
                                          ring-white transition group-hover:ring-4 group-focus-visible:ring-4") %>
        <span class="text-gray-400 group-hover:text-white"><%= profile.name %></span>
      <% end %>
    <% end %>

    <%# Último "avatar" da fileira: não escolhe perfil, leva ao formulário de criar um novo. %>
    <%= link_to new_profile_path, class: "group flex flex-col items-center gap-3" do %>
      <span class="flex h-24 w-24 sm:h-36 sm:w-36 items-center justify-center rounded-md border-2 border-dashed border-gray-600 text-4xl text-gray-500 transition group-hover:border-white group-hover:text-white">+</span>
      <span class="text-gray-400 group-hover:text-white">Adicionar perfil</span>
    <% end %>
  </div>

  <% if @profiles.empty? %>
    <p class="mt-10 text-gray-400">Nenhum perfil ainda. Clique em "Adicionar perfil" para criar o primeiro.</p>
  <% end %>

  <%# button_to destroy_user_session_path: DELETE /logout, sai da CONTA (diferente
      de trocar de perfil, que fica dentro da navbar depois que um perfil é escolhido). %>
  <%= button_to "Sair da conta", destroy_user_session_path, method: :delete,
        class: "mt-12 text-sm text-gray-400 hover:text-white cursor-pointer bg-transparent" %>
</div>
