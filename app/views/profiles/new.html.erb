<% content_for :title, "Adicionar perfil" %>

<div class="flex min-h-[80vh] flex-col items-center justify-center px-4">
  <%= render "shared/logo" %>

  <%= form_with model: @profile, url: profiles_path, class: "w-full max-w-sm space-y-6" do |form| %>
    <h1 class="text-2xl font-medium mb-2">Adicionar perfil</h1>

    <%= render "shared/error_messages", model: @profile, wrapper_class: nil %>

    <%= form.text_field :name, placeholder: "Nome do perfil", required: true, autofocus: true,
          class: "w-full rounded-md border border-white/20 bg-black/60 px-4 py-3 text-white placeholder-gray-500 focus:border-white focus:outline-none" %>

    <div>
      <p class="mb-3 text-sm text-gray-400">Cor do avatar</p>

      <%# Cada cor é um radio escondido (peer) + um círculo que ganha o anel
          branco quando o radio correspondente está marcado (peer-checked). %>
      <div class="flex gap-3">
        <% Profile::COLORS.each do |color| %>
          <label class="cursor-pointer">
            <%= form.radio_button :color, color, class: "peer hidden" %>
            <span class="block h-10 w-10 rounded-full ring-offset-2 ring-offset-ink peer-checked:ring-4 peer-checked:ring-white"
                  style="background-color: <%= color %>"></span>
          </label>
        <% end %>
      </div>
    </div>

    <%= form.submit "Criar perfil",
          class: "w-full rounded-md bg-brand px-4 py-3 font-semibold text-white cursor-pointer hover:bg-brand/90" %>
  <% end %>

  <%= link_to "Cancelar", profiles_path, class: "mt-6 text-sm text-gray-400 hover:text-white" %>
</div>
